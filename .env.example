# Optional host ports. Liveness and investment APIs do not require a Claude key.
API_PORT=8000
DASHBOARD_PORT=8501
# Compose sets dashboard's API_BASE_URL to http://api:8000 internally.

# News AI batch collectors only (not needed to run the app). Keep values out of Git.
# NYT Archive API key: https://developer.nytimes.com
NYT_API_KEY=
# Media Cloud API key: https://search.mediacloud.org
MEDIACLOUD_API_KEY=
# SEC asks for a name and contact e-mail, e.g. "FirstClass Capstone you@example.com"
SEC_USER_AGENT=
# Claude API key for risk tagging and /research: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional Chroma directory, relative to repo root (default: data/processed/news/chroma)
NEWS_CHROMA_PATH=
